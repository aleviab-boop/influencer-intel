<?xml version="1.0" encoding="UTF-8"?>
<!-- Reference copy. install.sh writes the real one to ~/Library/LaunchAgents/ with the actual
     absolute path to ~/relay-watchdog.sh substituted for __WATCHDOG_PATH__. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.influencerintel.relaywatch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__WATCHDOG_PATH__</string>
  </array>
  <key>StartInterval</key><integer>120</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/relay-watchdog.out.log</string>
  <key>StandardErrorPath</key><string>/tmp/relay-watchdog.err.log</string>
</dict>
</plist>
