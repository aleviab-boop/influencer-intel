BOLTIC_DATABASE_URL=<PASTE_VALUE_HERE>
BOLTIC_POOL_MAX=<PASTE_VALUE_HERE>
OPENAI_API_KEY=<PASTE_VALUE_HERE>
OPENAI_EMBEDDING_MODEL=<PASTE_VALUE_HERE>
OPENAI_CLASSIFICATION_MODEL=<PASTE_VALUE_HERE>
OPENAI_OUTREACH_MODEL=<PASTE_VALUE_HERE>

# --- Scraper service account ---
SERVICE_ACCOUNT_HANDLE=<PASTE_VALUE_HERE>
EXTENSION_PATH=<PASTE_VALUE_HERE>
CHROME_PROFILE_PATH=<PASTE_VALUE_HERE>
WORKER_POLL_INTERVAL_MS=<PASTE_VALUE_HERE>
MAX_ACTIONS_PER_HOUR=<PASTE_VALUE_HERE>
PLATFORM_CALLBACK_URL=<PASTE_VALUE_HERE>
SCRAPER_CALLBACK_SECRET=<PASTE_VALUE_HERE>

# --- Instagram Graph API (OAuth) ---
IG_APP_ID=<META_DEVELOPER_APP_ID>
IG_APP_SECRET=<META_DEVELOPER_APP_SECRET>
IG_REDIRECT_URI=http://localhost:3030/api/oauth/instagram/callback

# --- Gemini (Content Scoring) ---
GEMINI_API_KEY=<GOOGLE_AI_STUDIO_KEY>

# --- Apify (paid fallback for IG scraping when the free relay path is blocked) ---
# Optional: if unset, the app behaves exactly as before (throws 'blocked' on 401/429).
APIFY_TOKEN=<APIFY_PERSONAL_API_TOKEN>

# --- Transactional email (Resend) — creator invite + payment-received emails ---
# Optional: if RESEND_API_KEY is unset, all email sends are silent no-ops
# (nothing breaks — the in-app notification feed still works).
RESEND_API_KEY=<RESEND_API_KEY>
# Verified sender. Until you verify a domain in Resend, leave unset to use their
# shared onboarding@resend.dev sender. Once verified: "Name <notify@yourdomain.com>".
EMAIL_FROM=<VERIFIED_SENDER>
# Base URL used in email CTA links (defaults to the Vercel production URL).
APP_BASE_URL=https://influencer-intel-platform.vercel.app
